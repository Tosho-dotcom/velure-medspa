    {
      "parameters": {
        "jsCode": "// Shared Velure email shell (inline styles only — email clients ignore <style> blocks)\nconst shell = (title, bodyHtml) => `<!doctype html><html><body style=\"margin:0;padding:0;background:#FAF6F1;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#FAF6F1;padding:40px 16px;\">\n<tr><td align=\"center\">\n<table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;width:100%;background:#FFFFFF;border:1px solid #EFE6DA;border-radius:14px;\">\n<tr><td style=\"padding:40px 40px 8px 40px;font-family:Georgia,'Times New Roman',serif;font-size:26px;letter-spacing:-0.5px;color:#2B2420;\">Velure</td></tr>\n<tr><td style=\"padding:0 40px;font-family:Helvetica,Arial,sans-serif;font-size:10px;letter-spacing:3px;text-transform:uppercase;color:#B08968;\">Med Spa &middot; Scottsdale</td></tr>\n<tr><td style=\"padding:28px 40px 0 40px;\"><div style=\"height:1px;background:#EFE6DA;line-height:1px;\">&nbsp;</div></td></tr>\n<tr><td style=\"padding:28px 40px 0 40px;font-family:Georgia,'Times New Roman',serif;font-size:24px;line-height:1.25;color:#2B2420;\">${title}</td></tr>\n<tr><td style=\"padding:16px 40px 36px 40px;font-family:Helvetica,Arial,sans-serif;font-size:15px;line-height:1.65;color:#4A3F39;\">${bodyHtml}</td></tr>\n</table>\n<table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;width:100%;\">\n<tr><td style=\"padding:20px 8px;font-family:Helvetica,Arial,sans-serif;font-size:11px;line-height:1.6;color:#8A7D74;text-align:center;\">\nVelure Med Spa &middot; 1200 Desert Bloom Ave, Scottsdale, AZ &middot; (480) 555-0142<br>\nVelure is a fictional brand created as a demonstration project by <a href=\"https://thaus.co\" style=\"color:#8A7D74;\">Thaus</a>.\n</td></tr></table>\n</td></tr></table></body></html>`;\nconst esc = (v) => String(v ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst row = (k, v) => `<tr><td style=\"padding:6px 0;color:#8A7D74;width:120px;vertical-align:top;\">${k}</td><td style=\"padding:6px 0;color:#2B2420;\">${v}</td></tr>`;\n\nconst email = $('Validate Email').first().json.email;\nconst unsub = `https://your-n8n-instance.example.com/webhook/velure-unsubscribe?email=${encodeURIComponent(email)}`;\nconst html = shell('Welcome to The Velure Letter.',\n  `<p style=\"margin:0 0 14px 0;\">Thank you for subscribing. A few times a month you will receive honest skin notes from our team — seasonal treatments, simple routines that work, and first access to new openings.</p>\n   <p style=\"margin:0 0 14px 0;\">No noise, no pressure. Just good skin, considered.</p>\n   <p style=\"margin:22px 0 0 0;color:#2B2420;\">With care,<br>The Velure team</p>\n   <p style=\"margin:28px 0 0 0;font-size:12px;color:#8A7D74;\">Changed your mind? <a href=\"${unsub}\" style=\"color:#8A7D74;\">Unsubscribe</a> at any time.</p>`);\nreturn [{ json: { email, html, subject: 'Welcome to The Velure Letter' } }];"
      },
