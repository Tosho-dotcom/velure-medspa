      "parameters": {
        "jsCode": "const b = ($input.first().json.body) || {};\nconst s = (v) => (typeof v === 'string' ? v.trim() : '');\nif (s(b.company)) return [{ json: { honeypot: true, valid: false } }];\nconst email = s(b.email).toLowerCase();\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email)) return [{ json: { honeypot: false, valid: false, errors: { email: 'Please enter a valid email' } } }];\nreturn [{ json: { honeypot: false, valid: true, email, today: new Date().toISOString().slice(0, 10) } }];"
      },
