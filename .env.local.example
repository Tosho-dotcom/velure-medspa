NEXT_PUBLIC_N8N_BOOKING_WEBHOOK=https://your-n8n-instance.example.com/webhook/velure-booking
NEXT_PUBLIC_N8N_CONTACT_WEBHOOK=https://your-n8n-instance.example.com/webhook/velure-contact
NEXT_PUBLIC_N8N_SUBSCRIBE_WEBHOOK=https://your-n8n-instance.example.com/webhook/velure-subscribe
NEXT_PUBLIC_SITE_URL=https://velure-medspa.vercel.app
NEXT_PUBLIC_N8N_AVAILABILITY_WEBHOOK=https://your-n8n-instance.example.com/webhook/velure-availability

# Chat assistant (server-side only: never prefix these with NEXT_PUBLIC_)
N8N_CHAT_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/velure-chat
N8N_CHAT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Optional: extra allowed origins for /api/chat, comma-separated (custom domain with and without www)
CHAT_ALLOWED_ORIGINS=
# Optional but recommended: Upstash Redis for per-IP / per-session rate limits on /api/chat
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
